# .env.local にコピーして使う（.env.local は Git に入らない）。どれも省略できる。

# AI の判読に使うもの：auto（既定）/ ollama / anthropic / none
#   auto … ANTHROPIC_API_KEY があれば Claude、無ければ手元の Ollama
AI_PROVIDER=auto

# 手元で動かす VLM（Ollama）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b

# Claude を使う場合だけ設定する（写真が Anthropic に送られ、利用料が掛かる）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
